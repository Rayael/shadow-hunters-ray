{
  "name": "shadow-hunters-ray",
  "version": "2.0.0",
  "private": true,
  "description": "Shadow Hunters - jeu de plateau web multijoueur en temps réel",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "install:all": "npm install",
    "shared:install": "cd packages/shared && npm install",
    "server:install": "cd packages/server && npm install",
    "client:install": "cd packages/client && npm install",
    "prisma:generate": "cd packages/server && npx prisma generate",
    "prisma:migrate:dev": "cd packages/server && npx prisma migrate dev",
    "prisma:migrate:deploy": "cd packages/server && npx prisma migrate deploy",
    "server:dev": "cd packages/server && npm run dev",
    "server:build": "cd packages/server && npm run build",
    "server:start": "cd packages/server && npm start",
    "client:dev": "cd packages/client && npm run dev",
    "client:build": "cd packages/client && npm run build",
    "test:shared": "cd packages/shared && npx vitest run",
    "test:server": "cd packages/server && npx vitest run",
    "test:client": "cd packages/client && npx vitest run",
    "test:e2e": "cd packages/client && npx playwright test",
    "test:all": "npm run test:shared && npm run test:server && npm run test:client"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

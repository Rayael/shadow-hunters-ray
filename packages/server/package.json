{
  "name": "@shadow-hunters/server",
  "version": "2.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "prisma db push --accept-data-loss --skip-generate && node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@shadow-hunters/shared": "*",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/node": "^20.12.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "socket.io": "^4.7.5",
    "typescript": "^5.4.0",
    "vite": "8.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.11.0",
    "vitest": "^5.0.5"
  }
}

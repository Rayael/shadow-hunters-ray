{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@shadow-hunters/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src/**/*", "prisma/schema.prisma"],
  "exclude": ["node_modules", "dist", "vitest.config.ts"]
}
# =============================================================================
# Shadow Hunters — variables d'environnement (exemple, valeurs fictives)
# Copiez ce fichier vers .env et adaptez les valeurs avant de lancer.
# NE JAMAIS committer le fichier .env réel.
# =============================================================================

# Port d'écoute du serveur (fourni par l'hébergeur Render via PORT)
PORT=3001

# Clé secrète pour signer les cookies de session (générer une chaîne longue et aléatoire)
# Exemple : openssl rand -hex 32
SESSION_SECRET=changez-moi-avec-une-cle-secrete-aleatoire-et-longue

# Mot de passe commun du lobby (saisi par chaque joueur pour entrer)
# Définissez cette valeur dans le tableau de bord Render.
LOBBY_PASSWORD=EDGAR

# Délai d'inactivité après lequel une partie/lobby inactif peut être nettoyé (secondes)
LOBBY_IDLE_TIMEOUT_SECONDS=3600

# URL de base publique de l'application (pour les cookies Secure/SameSite en production)
PUBLIC_URL=https://shadow-hunters.onrender.com

# Niveau de journalisation
LOG_LEVEL=info

# Chaîne de connexion PostgreSQL (fournie par Render sous forme de variable DATABASE_URL)
# Exemple : postgresql://user:pass@host:5432/db?sslmode=require
DATABASE_URL=postgresql://shadowhunters:password@localhost:5432/shadowhunters